{
  "name": "Lights-out Audit Remediation CI",
  "projectRoots": [
    "electron"
  ],
  "steps": [
    {
      "name": "Dependency restore",
      "command": "npm",
      "args": ["ci", "--prefix", "electron"],
      "timeoutMs": 300000
    },
    {
      "name": "Syntax check — all electron and script JS files",
      "command": "node",
      "args": [
        "-e",
        "const fs=require('node:fs'),path=require('node:path'),{execFileSync}=require('node:child_process');for(const dir of ['electron','electron/scripts']){for(const f of fs.readdirSync(dir).filter(n=>n.endsWith('.js')).sort()){execFileSync(process.execPath,['--check',path.join(dir,f)],{stdio:'inherit'});}}"
      ],
      "timeoutMs": 60000
    },
    {
      "name": "ESLint",
      "command": "npm",
      "args": ["run", "lint", "--prefix", "electron"],
      "timeoutMs": 60000
    },
    {
      "name": "Unit tests",
      "command": "npm",
      "args": ["test", "--prefix", "electron"],
      "timeoutMs": 120000
    },
    {
      "name": "Static smoke",
      "command": "npm",
      "args": ["run", "smoke", "--prefix", "electron"],
      "timeoutMs": 120000
    }
  ]
}
