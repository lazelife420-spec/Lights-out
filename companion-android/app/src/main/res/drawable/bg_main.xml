<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid base color -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0D0E11" />
        </shape>
    </item>
    <!-- Top-centered subtle glow gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="400dp"
                android:centerX="0.5"
                android:centerY="0.0"
                android:startColor="#1A2030"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Bottom-centered very soft accent glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="350dp"
                android:centerX="0.5"
                android:centerY="1.0"
                android:startColor="#0D5B8CFF"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
